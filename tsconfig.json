{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "#lib": [
        "./src/lib/index.ts"
      ],
      "#lib/*": [
        "./src/lib/*"
      ],
      "#env/*": [
        "./.svelte-kit/ambient.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
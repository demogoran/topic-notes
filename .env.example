# App config via environment (create .env, do not commit)

# --- Database ---
DATABASE_PATH=./data/app.db

# --- Auth ---
AUTH_SECRET=change-me-please-to-a-long-random-string
SESSION_TTL_DAYS=30

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-your-key-here
# Model used for BOTH transcription (audio input) and text categorization
OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
OPENROUTER_APP_TITLE=VoiceNotes

# --- Soniox (optional — enables the cloud real-time STT engine) ---
SONIOX_API_KEY=

# --- Server ---
PORT=5173
ORIGIN=http://localhost:5173
